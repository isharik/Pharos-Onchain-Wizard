PORT=4317
HOST=127.0.0.1
# Public self-hosting requires a TLS proxy and an administrator password hash.
PUBLIC_ORIGIN=
# Optional separate browser origin, for example a Vercel frontend URL.
CORS_ORIGIN=
# Set true only for temporary public testing. This disables administrator login.
ALLOW_PUBLIC_ACCESS=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
PHAROS_NETWORK=mainnet
PHAROS_RPC_URL=https://rpc.pharos.xyz
PHAROS_CHAIN_ID=1672
CHAIN_MCP_URL=https://mcp.pharos.xyz/mcp
# Optional bearer credentials stay on the server.
CHAIN_MCP_TOKEN=
DOCS_MCP_URL=
DOCS_MCP_TOKEN=
# Set exact discovered search tool name and query argument key.
DOCS_SEARCH_TOOL=
DOCS_QUERY_KEY=query
DOCS_INDEX_URL=https://www.pharos.xyz/llms.txt
DOCS_MODE=index
# Installed official skill repository and Foundry cast executable.
SKILL_ENGINE_DIR=./vendor/pharos-skill-engine
# Leave blank for platform default: bundled npm Windows binary, or cast on PATH.
CAST_BIN=
DATA_DIR=./data
REQUEST_TIMEOUT_MS=15000
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Frontend-only build variable. Set this in Vercel, never in the backend service.
# VITE_API_BASE_URL=https://your-backend.onrender.com
